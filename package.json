{
  "name": "rbac-backend",
  "version": "1.0.0",
  "description": "Production-ready RBAC backend with Maker-Approver workflow",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "jobs:cleanup-tokens": "node scripts/cleanup-expired-tokens.js",
    "test": "node scripts/run-tests.js",
    "test:integration": "node scripts/run-tests.js",
    "test:unit": "node --test tests/unit",
    "test:contract": "node --test tests/contract"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "uuid": "^11.0.5",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
